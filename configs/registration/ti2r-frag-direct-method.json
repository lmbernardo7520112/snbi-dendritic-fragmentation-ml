{
  "schema": "TI2R-FRAG-DIRECT-METHOD-1",
  "direction": "moving_to_reference",
  "coordinates": "x_column_y_row_top_left_pixel_center_0_0",
  "mapping": "reference_xy_equals_moving_xy_minus_integer_crop_offset",
  "units": "native_pixels",
  "grid_rows": 6,
  "grid_columns": 6,
  "partition": "checkerboard_even_selection_odd_audit",
  "block_guard_px": 20,
  "text_top_fraction": 0.12,
  "text_bottom_fraction": 0.15,
  "native_border_px": 4,
  "chroma_distance_threshold": 20,
  "overlay_halo_px": 5,
  "minimum_valid_pixels_per_block": 512,
  "minimum_blocks_per_role": 8,
  "minimum_quadrants_per_role": 4,
  "minimum_reference_std_luma": 0.5,
  "minimum_reference_gradient_eigenvalue_ratio": 0.01,
  "selection_representation": "component_centered_native_sobel_xy_divided_by_eight",
  "selection_score": "equal_block_mean_vector_normalized_gradient_correlation",
  "selection_support": "reference_mask_intersection_all_finite_candidate_moving_masks",
  "minimum_selection_score": 0.8,
  "uniqueness_margin": 0.005,
  "audit_representation": "native_luminance",
  "audit_metric": "masked_overlap_normalized_local_cross_correlation_via_exact_fft_sums",
  "audit_lag_radius_px": 12,
  "audit_subpixel": "three_point_parabolic_residual_only_cap_half_pixel",
  "audit_lag_support_policy": "every_lag_at_least_minimum_pixels_else_block_unavailable",
  "audit_undefined_policy": "any_undefined_lag_or_nonunique_maximum_fails_frame_without_dropping_residual",
  "audit_peak_tie_tolerance": 1e-9,
  "numerical_epsilon": 1e-12,
  "median_limit_px": 1.0,
  "p95_limit_px": 2.0,
  "maximum_limit_px": 3.0,
  "minimum_identifiable_development_frames": 2,
  "minimum_identifiable_holdout_frames": 1,
  "non_identifiable_policy": "reference_only_not_pass_not_disagreement",
  "all_identifiable_frames_must_pass": true,
  "mapping_refinement": "forbidden"
}
