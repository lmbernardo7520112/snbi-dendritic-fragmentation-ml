{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/snbi/time-rule.schema.json",
  "title": "TI-1 physical time rule",
  "type": "object",
  "required": ["rule_version", "delta_t_seconds", "frame_index_origin", "time_origin_seconds", "reported_fps_is_physical_time", "equation", "applicability", "provenance"],
  "properties": {
    "rule_version": {"const": "1.0.0"},
    "delta_t_seconds": {"const": "1.18"},
    "frame_index_origin": {"const": 0},
    "time_origin_seconds": {"const": "0.00"},
    "reported_fps_is_physical_time": {"const": false},
    "equation": {"type": "string"},
    "applicability": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
