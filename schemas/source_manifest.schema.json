{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lmbernardo7520112/snbi-dendritic-fragmentation-ml/schemas/source_manifest.schema.json",
  "title": "TI-0 source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "project_id", "created_at", "custody_policy", "containers", "sources"],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "project_id": {"const": "SNBI-DF-ML"},
    "created_at": {"type": "string", "format": "date"},
    "custody_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_sources_immutable", "raw_sources_committed", "verification_algorithm"],
      "properties": {
        "raw_sources_immutable": {"const": true},
        "raw_sources_committed": {"const": false},
        "verification_algorithm": {"const": "sha256"}
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["container_id", "filename", "sha256", "size_bytes"],
        "properties": {
          "container_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "source_kind", "modality", "condition", "semantic_role",
        "sha256", "size_bytes", "hash_scope", "storage", "redistribution"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
        "source_kind": {"enum": ["video", "document"]},
        "modality": {
          "enum": [
            "xray_radiography",
            "relative_solute_field",
            "cumulative_fragmentation_annotation",
            "scientific_document",
            "academic_record"
          ]
        },
        "condition": {
          "enum": ["bottom_up_anti_parallel", "top_down_parallel", "not_applicable"]
        },
        "semantic_role": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "hash_scope": {"enum": ["raw_file_bytes", "uncompressed_zip_member_bytes"]},
        "storage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "filename"],
              "properties": {
                "kind": {"const": "file"},
                "filename": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "container_id", "member_path"],
              "properties": {
                "kind": {"const": "zip_member"},
                "container_id": {"type": "string"},
                "member_path": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "redistribution": {"const": "external_not_redistributed"}
      }
    }
  }
}

